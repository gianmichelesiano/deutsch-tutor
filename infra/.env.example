# Deutsch-Tutor — environment di sviluppo
# Copia in .env (alla root) e adatta i valori se serve.
# I default qui sotto coprono lo sviluppo locale via Docker Compose.

# --- PostgreSQL ---
POSTGRES_USER=deutsch
POSTGRES_PASSWORD=deutsch
POSTGRES_DB=deutsch_tutor
# Porta host del DB: 5433 per non collidere con un eventuale Postgres locale su 5432.
POSTGRES_PORT=5433

# --- API ---
# DATABASE_URL è composta automaticamente in docker-compose dai valori sopra.
# Sovrascrivila SOLO se esegui l'API fuori da Docker:
# DATABASE_URL=postgresql+asyncpg://deutsch:deutsch@localhost:5433/deutsch_tutor

# --- Web ---
# Porta host del frontend (la :3000 è usata da un altro progetto).
WEB_PORT=3100

# --- App ---
# Nome utente mostrato in Home.
USER_NAME=Gianmichele

# --- LLM (Fase 3) ---
# Provider "local" = endpoint OpenAI-compatibile. Default: DeepSeek remoto.
# Chiave: https://platform.deepseek.com/api_keys
LOCAL_LLM_BASE_URL=https://api.deepseek.com
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=deepseek-flash          # deepseek-flash | deepseek-v4-pro (ritirato dal 14.09.2026)
# Alternativa: llama.cpp / ds4 in locale (nessuna chiave):
# LOCAL_LLM_BASE_URL=http://host.docker.internal:8008/v1
# LOCAL_LLM_MODEL=deepseek-v4-flash
# LOCAL_LLM_REPEAT_PENALTY=1.15
# Cloud Anthropic.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# LLM_PROVIDER_MODE=auto   # auto | local-only | cloud-only | mock
# --- Parametri roleplay ---
# DeepSeek Flash è un reasoning model: il thinking è DISATTIVATO per il roleplay
# (altrimenti max_tokens=200 viene consumato dal ragionamento e il JSON non esce).
# LOCAL_LLM_THINKING_DISABLED=true
# LOCAL_LLM_REPEAT_PENALTY=0   # solo llama.cpp (>1 penalizza); 0 = non inviata
