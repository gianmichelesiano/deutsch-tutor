# Deutsch-Tutor — development environment
# Copy to .env (at the root) and adjust the values if needed.
# The defaults below cover local development via Docker Compose.

# --- PostgreSQL ---
POSTGRES_USER=deutsch
POSTGRES_PASSWORD=deutsch
POSTGRES_DB=deutsch_tutor
# Host port for the DB: 5433 to avoid clashing with a local Postgres on 5432.
POSTGRES_PORT=5433

# --- API ---
# DATABASE_URL is composed automatically in docker-compose from the values above.
# Override it ONLY if you run the API outside Docker:
# DATABASE_URL=postgresql+asyncpg://deutsch:deutsch@localhost:5433/deutsch_tutor

# Host port for the backend (:8000 is too common, risk of collision).
API_PORT=8118

# --- Web ---
# Host port for the frontend (:3000 is taken by another project).
WEB_PORT=3100

# --- App ---
# User name shown on the Home page.
USER_NAME=Gianmichele

# --- LLM ---
# The "local" provider is an OpenAI-compatible endpoint. Default: remote DeepSeek.
# Key: https://platform.deepseek.com/api_keys
LOCAL_LLM_BASE_URL=https://api.deepseek.com
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=deepseek-flash          # deepseek-flash | deepseek-v4-pro (retired on 2026-09-14)

# Alternative: llama.cpp / ds4 running locally (no key needed):
# LOCAL_LLM_BASE_URL=http://host.docker.internal:8008/v1
# LOCAL_LLM_MODEL=deepseek-v4-flash
# LOCAL_LLM_REPEAT_PENALTY=1.15

# Anthropic cloud (fallback in `auto` mode).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# LLM_PROVIDER_MODE=auto   # auto | local-only | cloud-only | mock

# --- Roleplay parameters ---
# DeepSeek Flash is a reasoning model: thinking is DISABLED for roleplay
# (otherwise max_tokens=200 gets eaten by the reasoning and no JSON comes out).
# LOCAL_LLM_THINKING_DISABLED=true
# LOCAL_LLM_REPEAT_PENALTY=0   # llama.cpp only (>1 penalizes); 0 = not sent
